# Used by docker-compose build args
# Copy to .env before: docker compose up --build
# For npm run dev, copy the same values to .env.local

NEXT_PUBLIC_API_URL=https://api.handiz.org/api/v1/
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.handiz.org
NEXT_PUBLIC_LMS_URL=https://learn.handiz.org
NEXT_PUBLIC_MAIN_SITE_URL=https://handiz.org
# E.164 digits only, e.g. 96171601751 for +961 71 601 751
NEXT_PUBLIC_WHATSAPP_NUMBER=96171601751
NEXT_PUBLIC_GA_MEASUREMENT_ID=
